{
  "name": "dsh-lfaa",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Development workspace for the complete native dsh-lfaa plugin",
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "./dist/packages/dsh-lfaa/index.mjs",
  "exports": {
    ".": "./dist/packages/dsh-lfaa/index.mjs",
    "./client": "./dist/packages/dsh-lfaa/client.js",
    "./package.json": "./dist/packages/dsh-lfaa/package.json"
  },
  "files": [
    "dist/packages/dsh-lfaa/**",
    "README.md",
    "README.zh.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yubboo/dsh-lfaa.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-subprocess": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-sandbox": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./dist/packages/dsh-lfaa/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "workspaces": [
    "packages/dsh-lfaa-appearance",
    "packages/dsh-lfaa-workspace",
    "packages/dsh-lfaa-minecraft"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-workspace.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
