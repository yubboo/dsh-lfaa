{
  "name": "dsh-lfaa",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "A complete native DSH plugin with its own business modules and workspace integrations",
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "docs"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-subprocess": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-sandbox": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "dsh-lfaa-appearance": "0.1.0",
    "dsh-lfaa-workspace": "0.1.0",
    "dsh-lfaa-minecraft": "0.1.0"
  }
}
